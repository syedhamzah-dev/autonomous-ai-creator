# General Application Settings
APP_NAME="Autonomous AI Creator"
APP_ENV="dev"  # dev, prod, test
LOG_LEVEL="info"

# Server Settings
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# Real LLM API Provider Settings
LLM_API_KEY="your-gemini-api-key-here"
LLM_MODEL="gemini-2.5-flash"
# DATABASE_URL="sqlite:///./agent.db"

# Topic Discovery Settings
# A JSON-serialized array or comma-separated list of RSS/Atom feed URLs
# DISCOVERY_FEEDS="https://techcrunch.com/category/artificial-intelligence/feed/,https://developer.nvidia.com/blog/feed/"

# Editorial Judgment Settings
EDITORIAL_ENGINE_TYPE="llm"   # "deterministic" (offline/test) or "llm" (production — recommended)
# EDITORIAL_THRESHOLD=6.0

# Autonomous Scheduling Settings
# AUTONOMOUS_ENABLED=true
# AUTONOMOUS_INTERVAL_SECONDS=3600.0

